<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Portfolio</title>

    <style>
        body.dark {
            background: #121212;
            color: #ffffff;
        }
        .error {
            color: red;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <button id="themeToggle">Toggle Dark Mode</button>

    <h1>My Portfolio</h1>

    <h2>About Me</h2>
    <p>
        Hello! My name is Nick Correia. I am currently studying AI/ML and interested
        in web development and software programming.
    </p>

    <h2>Contact Me</h2>

    <form id="contactForm">
        <label>Email:</label><br>
        <input type="email" id="email"><br>
        <span class="error" id="emailError"></span><br>

        <label>Phone:</label><br>
        <input type="text" id="phone"><br>
        <span class="error" id="phoneError"></span><br>

        <label>Password:</label><br>
        <input type="password" id="password"><br>
        <span class="error" id="passwordError"></span><br><br>

        <input type="submit" value="Submit">
    </form>

    <p id="savedData"></p>

    <script src="script.js"></script>
</body>
</html>
const form = document.getElementById("contactForm");
const themeBtn = document.getElementById("themeToggle");

// Load saved theme
if (localStorage.getItem("theme") === "dark") {
    document.body.classList.add("dark");
}

// Dark mode toggle
themeBtn.addEventListener("click", () => {
    document.body.classList.toggle("dark");
    localStorage.setItem(
        "theme",
        document.body.classList.contains("dark") ? "dark" : "light"
    );
});

// Form validation
form.addEventListener("submit", e => {
    e.preventDefault();

    const email = document.getElementById("email").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const password = document.getElementById("password").value.trim();

    emailError.textContent = "";
    phoneError.textContent = "";
    passwordError.textContent = "";

    let valid = true;

    if (!email.includes("@")) {
        emailError.textContent = "Invalid email address";
        valid = false;
    }

    if (!/^\d{10}$/.test(phone)) {
        phoneError.textContent = "Phone must be 10 digits";
        valid = false;
    }

    if (password.length < 6) {
        passwordError.textContent = "Password must be at least 6 characters";
        valid = false;
    }

    if (!valid) return;

    localStorage.setItem(
        "userData",
        JSON.stringify({ email, phone })
    );

    alert("Data saved successfully");
    form.reset();
});


// Restore saved user data into form on refresh
const saved = JSON.parse(localStorage.getItem("userData"));

if (saved) {
    document.getElementById("email").value = saved.email;
    document.getElementById("phone").value = saved.phone;

    document.getElementById("savedData").textContent =
        `Saved Email: ${saved.email}, Phone: ${saved.phone}`;
}
