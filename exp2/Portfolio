<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Portfolio</title>

    <style>
        /* Global styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            line-height: 1.6;
            background-color: #f4f4f4;
        }

        /* Navbar */
        #navbar {
            position: fixed;
            top: 0;
            width: 100%;
            background-color: #0077cc;
            padding: 15px 30px;
            display: flex;
            justify-content: flex-start;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            z-index: 1000;
        }

        #navbar a {
            color: #fff;
            text-decoration: none;
            margin-right: 20px;
            font-weight: bold;
        }

        #navbar a:hover {
            text-decoration: underline;
        }

        /* Sections */
        section {
            padding: 100px 20px 60px 20px; /* top padding to offset navbar */
            max-width: 1000px;
            margin: 0 auto;
        }

        /* Welcome section */
        #welcome-section {
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            color: white;
            text-align: center;
            border-radius: 12px;
        }

        #welcome-section h1 {
            font-size: 48px;
            margin: 0;
            padding: 60px 20px;
        }

        /* Projects section */
        #project-section {
            margin-top: 60px;
        }

        .project-tile {
            background-color: #fff;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .project-tile:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .project-tile a {
            color: #0077cc;
            text-decoration: none;
            font-weight: bold;
        }

        .project-tile a:hover {
            text-decoration: underline;
        }

        /* Profile link */
        #profile-link {
            display: inline-block;
            margin-top: 10px;
            padding: 10px 15px;
            background-color: #24292e;
            color: white;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            transition: background 0.3s ease;
        }

        #profile-link:hover {
            background-color: #444;
        }

        /* Responsive media query */
        @media (max-width: 700px) {
            #welcome-section h1 {
                font-size: 36px;
            }

            #navbar {
                flex-direction: column;
                align-items: flex-start;
            }

            #navbar a {
                margin-bottom: 10px;
            }

            .project-tile {
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav id="navbar">
        <a href="#welcome-section">Welcome</a>
        <a href="#project-section">Projects</a>
    </nav>

    <!-- Welcome Section -->
    <section id="welcome-section">
        <h1>Welcome to My Portfolio</h1>
        <p>Hi! I’m Royce, a web developer passionate about creating modern web applications.</p>
        <a id="profile-link" href="https://github.com/correianick4-cmd" target="_blank">My GitHub Profile</a>
    </section>

    <!-- Projects Section -->
    <section id="project-section">
        <h2>Projects</h2>

        <div class="project-tile">
            <h3>Portfolio Website</h3>
            <p>A responsive portfolio website built using HTML, CSS, and JavaScript.</p>
            <a href="https://github.com/correianick4-cmd/AIML-WPD-10/blob/main/exp1/Portfolio" target="_blank">View Project</a>
        </div>
        <div class="project-tile">
     <h3>Project 1</h3>
     <p>This is my first project</p>
     <a href="https://github.com/correianick4-cmd/AIML-WPD-10/blob/main/exp1/recitation" target="_blank">View Project</a>
 </div>       

    </section>

</body>
</html>
