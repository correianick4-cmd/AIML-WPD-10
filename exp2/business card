<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Business Card</title>
<style>
    body {
        background-color: rgb(20, 145, 218);
        font-family: Arial, sans-serif;

    }
.business-card {
  width: 300px;
  background-color: white;
  padding: 20px;
  margin-top: 100px;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
  font-size: 16px;
}

.profile-image {
  max-width: 100%;
}

p {
  margin-top: 5px;
  margin-bottom: 5px;
}

a {
  text-decoration: none;
}
</style>
</head>
<body>

  <div class="business-card">
    <img
      class="profile-image"
      src="https://cdn.freecodecamp.org/curriculum/labs/flower.jpg"
      alt="Profile picture of a flower"
    >

    <p class="full-name">Nick Correia</p>
    <p class="designation">Web Developer</p>
    <p class="company">Tech Solutions Inc.</p>

    <hr>

    <p>Nickcorre@email.com</p>
    <p>+1 (555) 123-4567</p>

    <a class="portfolio-link" href="https://example.com">Portfolio</a>

    <hr>

    <div class="social-media">
      <h2>Connect with me</h2>
      <a href="https://twitter.com">Twitter</a><br>
      <a href="https://linkedin.com">LinkedIn</a><br>
      <a href="https://github.com">GitHub</a>
    </div>
  </div>

</body>
</html>
